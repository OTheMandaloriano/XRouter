{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "xrouter-combos": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "XRouter • Combos",
      "options": {
        "baseURL": "http://localhost:20127/v1",
        "apiKey": "sk-sua-chave-xrouter-aqui"
      },
      "models": {
        "best-coding": {
          "name": "Best Coding (Auto Fallback)",
          "attachment": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "best-free": {
          "name": "Best Free (100% Gratuito)",
          "attachment": true,
          "modalities": {
            "input": [
              "text",
